(* Knuth-Yao dice protocol *)

p0 = flip 0.5 (
  q0 ! l1 . end
,
  q0 ! l2 . end
)

q0 = (
  p0 ? l1 . (mu t .
    p1 ! go . q3 ? redo . t
  )
  + p0 ? l2 . (mu t .
    p2 ! go . q6 ? redo . t
  )
)

p1 = (mu t .
  q0 ? go . flip 0.5 (
    q1 ! l3 . t
  ,
    q1 ! l4 . t
  )
)

q1 = (mu t .
  (
    p1 ? l3 . p3 ! go . t
    + p1 ? l4 . p4 ! go . t
  )
)

p2 = (mu t .
  q0 ? go . flip 0.5 (
    q2 ! l5 . t
  ,
    q2 ! l6 . t
  )
)

q2 = (mu t .
  (
    p2 ? l5 . p5 ! go . t
    + p2 ? l6 . p6 ! go . t
  )
)

p3 = (mu t .
  q1 ? go . flip 0.5 (
    q3 ! l1 . t
  ,
    q3 ! d1 . end
  )
)

q3 = (mu t .
  (
    p3 ? l1 . q0 ! redo . t
    + p3 ? d1 . dice1 ! done . end
  )
)

p4 = q1 ? go . flip 0.5 (
  q4 ! d2 . end
,
  q4 ! d3 . end
)

q4 = (
  p4 ? d2 . dice2 ! done . end
  + p4 ? d3 . dice3 ! done . end
)

p5 = q2 ? go . flip 0.5 (
  q5 ! d4 . end
,
  q5 ! d5 . end
)

q5 = (
  p5 ? d4 . dice4 ! done . end
  + p5 ? d5 . dice5 ! done . end
)

p6 = (mu t .
  q2 ? go . flip 0.5 (
    q6 ! d6 . end
  ,
    q6 ! l2 . end
  )
)

q6 = (mu t .
  (
    p6 ? d6 . dice6 ! done . end
    + p6 ? l2 . q0 ! redo . t
  )
)

dice1 = q3 ? done . (mu t .
  dummy ! repeat . t
)

dice2 = q4 ? done . end

dice3 = q4 ? done . end

dice4 = q5 ? done . end

dice5 = q5 ? done . end

dice6 = q6 ? done . end

dummy = (mu t .
  dice1 ? repeat . t
)
